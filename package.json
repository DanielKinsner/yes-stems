{
  "name": "yes-stems",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:local": "vite preview --host 127.0.0.1 --port 4173",
    "screenshot:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/capture-ui-screenshot.ps1",
    "version:bump": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/version-bump.ps1",
    "verify:branch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/assert-main-branch.ps1",
    "verify:screenshot": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-ui-screenshot.ps1",
    "verify:ui": "npm run verify:branch && npm run verify:frontend && npm run verify:screenshot",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:frontend": "npm test && npm run test:packaging && npm run build",
    "verify:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "verify:fast": "npm run verify:frontend && npm run verify:rust",
    "verify:release": "npm run verify:branch && npm run verify:fast && npm run verify:screenshot",
    "test:packaging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-demucs-runtime-contract.ps1",
    "verify:demucs-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-demucs-runtime.ps1",
    "build:demucs-sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-demucs-sidecar.ps1",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "build:windows:classic": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -ClassicOnly",
    "build:windows:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -RequireSigning",
    "build:windows:standalone": "npm run build:demucs-sidecar && npm run build:windows",
    "build:windows:standalone:signed": "npm run build:demucs-sidecar && npm run build:windows:signed",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tauri-apps/cli": "^2.11.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
