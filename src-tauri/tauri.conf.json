{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YES Stems",
  "version": "0.1.0",
  "identifier": "com.yesstems.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YES Stems",
        "width": 1920,
        "height": 1080,
        "minWidth": 1200,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/working-stems/**",
          "$APPLOCALDATA/working-stems/**",
          "$TEMP/yes-stems/working-stems/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "YES Stems",
    "copyright": "© 2026 YES Stems Contributors",
    "category": "Music",
    "homepage": "https://github.com/DanielKinsner/yes-stems",
    "shortDescription": "Local, offline music stem separation.",
    "longDescription": "YES Stems extracts musical stems (vocals, drums, bass, and more) from any audio file entirely on your own machine, using local Demucs ML models or a built-in Rust DSP engine. No upload, no cloud, no account — your audio never leaves your computer.",
    "targets": "all",
    "resources": {
      "resources/demucs-runtime": "demucs-runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
